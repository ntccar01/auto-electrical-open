var NTC_HTML_ = {"Teacher":"<!DOCTYPE html><html lang=\"zh-TW\"><head><base target=\"_top\"><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<style>body{font:16px system-ui,sans-serif;max-width:1100px;margin:10px auto;padding:16px;color:#243746;background:#f3f6f8}section{background:white;padding:20px;margin:16px 0;border-radius:10px}button,input{font:inherit;padding:8px;margin:4px}table{border-collapse:collapse;width:100%}th,td{padding:8px;border:1px solid #ccd5df;text-align:left}#status{white-space:pre-wrap} .table-wrap{overflow:auto}button:disabled{opacity:.5}.hint{color:#5d6d7e;font-size:14px}.ok{color:#1e8449}.warn{color:#b9770e}.bad{color:#c0392b}#slips{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:12px}.slip{border:1px dashed #7f8c8d;padding:10px;border-radius:6px;break-inside:avoid}.slip b{font-size:22px;letter-spacing:3px;font-family:ui-monospace,Consolas,monospace}@media (max-width:520px){body{margin:4px;padding:4px;font-size:15px}section{padding:12px;margin:8px 0}#slips{grid-template-columns:1fr}input{width:calc(100% - 28px)}}@media print{#slips{grid-template-columns:repeat(3,1fr)!important}body.print-slips>*:not(#slipSection){display:none!important}body.print-slips #slipSection>*:not(#slips){display:none!important}body.print-slips{background:white;margin:0;max-width:none}}</style></head>\n<body><h1 class=\"full\">汽車電系雲端教師端</h1><p class=\"full\">匯入檔案為學生端初評，請覆閱後再核章。</p><p id=\"status\" role=\"status\">正在讀取…</p>\n<section data-sec=\"import\"><h2>匯入舊版 JSON 提交檔</h2><input id=\"importSemester\" placeholder=\"本批匯入學期，例如 115-1\"><input id=\"file\" type=\"file\" accept=\".json,application/json\"><button id=\"importBtn\">匯入提交檔</button><button id=\"refresh\">重新整理</button><p>使用學生端「匯出提交檔」或本機教師端「匯出雲端提交檔」。重複 ID 會略過；本機核章與調分不會自動轉為雲端核章。</p></section>\n<section data-sec=\"upload\"><h2>開放學生線上上傳</h2>\n<p class=\"hint\">按下開放後，該班學生可在考評結果畫面按「上傳成績」，輸入 6 碼代碼直接送到這裡；時間到自動關閉。沒開放時學生只能下載成績檔交給你。</p>\n<input id=\"upCls\" placeholder=\"班級代號\"><input id=\"upMin\" type=\"number\" min=\"5\" max=\"240\" value=\"50\" style=\"width:110px\"> 分鐘\n<button id=\"upOpen\">開放上傳</button><button id=\"upClose\">關閉上傳</button><button id=\"upRefresh\">重新整理狀態</button>\n<p id=\"upInfo\" class=\"hint\">按「重新整理狀態」查看目前開放的班級。</p></section>\n<section data-sec=\"import\"><h2>匯入學生成績檔（CSV）</h2>\n<p class=\"hint\">學生在考評結果畫面按「下載成績檔」，用通訊軟體傳給你。請匯入<strong>原始檔</strong>（用 Excel 開啟後另存會使驗證失敗）。可一次選多個檔案。</p>\n<input id=\"csvSemester\" placeholder=\"本批學期（空白則用檔案內學期）\"><input id=\"csvFiles\" type=\"file\" accept=\".csv,text/csv\" multiple><button id=\"csvPreview\">檢查檔案</button>\n<div class=\"table-wrap\"><table><thead><tr><th>檔案</th><th>班級／座號</th><th>單元／試卷</th><th>總分</th><th>及格</th><th>第幾次</th><th>驗證</th></tr></thead><tbody id=\"csvRows\"></tbody></table></div>\n<label><input type=\"checkbox\" id=\"csvIncludeUnverified\">也匯入「未簽章」與「名單中無此座號」的檔案（內容被修改、練習紀錄與重複檔一律不匯入）</label>\n<button id=\"csvImport\" disabled>匯入檢查結果</button></section>\n<section id=\"slipSection\" data-sec=\"roster\"><h2>學生名單與 6 碼代碼</h2>\n<p class=\"hint\">名單只有班級代號與座號，不放姓名。代碼只會在產生或重設時顯示這一次，請當場列印或抄下；試算表只保存加密後的資料。</p>\n<input id=\"rosterCls\" placeholder=\"班級代號\"><input id=\"rosterFrom\" type=\"number\" min=\"1\" max=\"999\" placeholder=\"起始座號\" style=\"width:110px\"><input id=\"rosterTo\" type=\"number\" min=\"1\" max=\"999\" placeholder=\"結束座號\" style=\"width:110px\"><button id=\"rosterCreate\">產生代碼</button>\n<br><input id=\"resetSeat\" type=\"number\" min=\"1\" max=\"999\" placeholder=\"座號\" style=\"width:110px\"><button id=\"rosterReset\">重設此座號代碼</button><button id=\"rosterRemove\">移除此座號</button><button id=\"rosterList\">查看名單</button><button id=\"printSlips\" disabled>列印代碼條</button>\n<p id=\"rosterInfo\" class=\"hint\"></p><div id=\"slips\"></div></section>\n<section data-sec=\"review\"><h2>覆閱、調分與核章</h2><div class=\"table-wrap\"><table><thead><tr><th>學期</th><th>單元／題目</th><th>班級／座號</th><th>來源／驗證</th><th>及格</th><th>初評</th><th>調分後</th><th>核章</th><th>操作</th></tr></thead><tbody id=\"rows\"></tbody></table></div></section>\n<section data-sec=\"advanced\"><h2>核發證書</h2><input id=\"cls\" placeholder=\"班級代號\"><input id=\"seat\" placeholder=\"座號\"><input id=\"semester\" placeholder=\"學期，例如 115-1\"><button id=\"issue\">核發學期已核章紀錄證書</button><p>核發後可複製學生查驗連結。需先在指令碼屬性設定唯讀查驗部署網址 STUDENT_VERIFY_URL。</p><input id=\"studentLink\" aria-label=\"學生查驗連結\" placeholder=\"核發後產生學生查驗連結\" readonly><button id=\"copyStudentLink\" type=\"button\" disabled>複製學生查驗連結</button></section>\n<section data-sec=\"advanced\"><h2>面試學習歷程報告</h2><p>使用上方班級、座號與學期，只納入已核章紀錄。連結持有者登入 Google 帳戶後可看到未遮罩班級／座號、分項及成績，30 天到期。身份仍須配合學生證及校方資料核對。</p><label><input type=\"checkbox\" id=\"reportConsent\">教師已確認學生同意提供面試教授查閱</label><button id=\"issueReport\">產生面試報告連結</button><input id=\"reportLink\" aria-label=\"面試報告連結\" readonly placeholder=\"產生後可選取複製\"></section>\n<section data-sec=\"advanced\"><h2>查驗雲端證書</h2><input id=\"certId\" placeholder=\"證書 ID\"><button id=\"verify\">查驗</button><p id=\"verification\"></p></section>\n<script>\n'use strict';\nconst $=id=>document.getElementById(id);let busy=false;\nfunction setBusy(value){busy=value;document.querySelectorAll('button').forEach(b=>b.disabled=value||(b.id==='copyStudentLink'&&!$('studentLink').value));}\nfunction rpc(method,args,onSuccess){if(busy)return;setBusy(true);$('status').textContent='處理中…';google.script.run.withFailureHandler(e=>{setBusy(false);$('status').textContent='未完成：'+e.message;}).withSuccessHandler(result=>{setBusy(false);$('status').textContent='已完成';onSuccess(result);})[method](...args);}\nfunction render(rows){$('rows').replaceChildren();rows.forEach(r=>{const tr=document.createElement('tr');const total=Math.max(0,Math.min(100,r.summary.score+((r.adjust&&r.adjust.delta)||0)));[r.semester,r.unit+' / '+r.faultConfigId,r.cls+' / '+r.seat,verifyText(r),r.summary.pass?'及格':'未及格',r.summary.score,total,r.approved?'已核章':'待覆閱'].forEach(v=>{const td=document.createElement('td');td.textContent=String(v);tr.append(td);});const actions=document.createElement('td');if(!r.approved){const adjust=document.createElement('button');adjust.textContent='調分';adjust.onclick=()=>{const input=prompt('調分（-10～+10 整數）','0');if(input===null)return;const note=prompt('調分說明');if(!note)return;rpc('adjustRecord',[r.recordId,Number(input),note],reload);};const approve=document.createElement('button');approve.textContent='覆閱並核章';approve.onclick=()=>rpc('approveRecord',[r.recordId],reload);actions.append(adjust,approve);}tr.append(actions);$('rows').append(tr);});}\nfunction reload(){rpc('listRecords',[],render);}\n$('refresh').onclick=reload;\n$('importBtn').onclick=async()=>{const file=$('file').files[0];if(!file){$('status').textContent='請選擇提交檔';return;}if(file.size>1000000){$('status').textContent='檔案不得超過 1 MB';return;}try{const text=await file.text();rpc('importRecords',[text,$('importSemester').value.trim()],result=>{rpc('listRecords',[],rows=>{render(rows);$('status').textContent='已匯入 '+result.imported+' 筆，略過重複 '+result.duplicates+' 筆';});});}catch(e){$('status').textContent='讀取失敗：'+e.message;}};\n$('issue').onclick=()=>{ $('studentLink').value='';$('copyStudentLink').disabled=true;rpc('issueCertificate',[$('cls').value.trim(),$('seat').value.trim(),$('semester').value.trim()],cert=>{$('certId').value=cert.certId;$('status').textContent='已核發：'+cert.certId;rpc('getStudentVerifyUrl',[],base=>{if(!base){$('status').textContent='已核發：'+cert.certId+'；尚未設定 STUDENT_VERIFY_URL，暫無學生查驗連結。';return;}$('studentLink').value=base+'?page=verify&id='+encodeURIComponent(cert.certId);$('copyStudentLink').disabled=false;$('status').textContent='證書已核發，學生查驗連結已產生。';});});};\n$('verify').onclick=()=>rpc('verifyCertificate',[$('certId').value.trim()],result=>{$('verification').textContent=result.valid?'雲端查驗通過：'+result.cls+'／座號 '+result.seat+'／'+result.semester:'查無有效證書或簽章不符';});\n$('copyStudentLink').onclick=async()=>{const link=$('studentLink').value;if(!link)return;try{await navigator.clipboard.writeText(link);$('status').textContent='學生查驗連結已複製。';}catch(e){$('studentLink').focus();$('studentLink').select();const ok=document.execCommand('copy');$('status').textContent=ok?'學生查驗連結已複製。':'請手動複製欄位中的學生查驗連結。';}};\n$('issueReport').onclick=()=>{if(!$('reportConsent').checked){$('status').textContent='請先確認學生同意。';return;}$('reportLink').value='';rpc('issueInterviewReport',[$('cls').value.trim(),$('seat').value.trim(),$('semester').value.trim(),true],report=>{rpc('getStudentVerifyUrl',[],base=>{if(!base){$('status').textContent='報告已產生，但尚未設定 STUDENT_VERIFY_URL。';return;}$('reportLink').value=base+'?page=interview&id='+encodeURIComponent(report.reportId);$('reportConsent').checked=false;$('status').textContent='報告連結已產生，30 天後到期；請選取連結複製給學生。';});});};\nfunction showUpload(list){$('upInfo').textContent=list.length?'開放中：'+list.map(x=>x.cls+'（剩 '+x.minutesLeft+' 分鐘）').join('、'):'目前沒有開放上傳的班級。';}\n$('upOpen').onclick=()=>rpc('openUpload',[$('upCls').value.trim(),Number($('upMin').value)],showUpload);\n$('upClose').onclick=()=>rpc('closeUpload',[$('upCls').value.trim()],showUpload);\n$('upRefresh').onclick=()=>rpc('uploadStatus',[],showUpload);\nconst VERIFY_TEXT={readableEdited:'⚠️ 可讀欄位被修改',ok:'✅ 驗證通過',unsigned:'❔ 未簽章',noRoster:'❔ 名單無此座號',tampered:'⚠️ 內容被修改'};\nfunction verifyText(r){if(r.source==='upload')return '線上上傳 ✅'+(r.attempt?'（第'+r.attempt+'次）':'');if(r.source!=='csv')return 'JSON 提交檔';return 'CSV '+(VERIFY_TEXT[r.verify]||r.verify||'')+(r.attempt?'（第'+r.attempt+'次）':'');}\nfunction statusClass(s){return s==='ok'?'ok':(s==='tampered'||s==='invalid'||s==='readableEdited')?'bad':'warn';}\nlet csvPayload=null;\nasync function readCsvFiles(){const list=Array.from($('csvFiles').files);if(!list.length)throw new Error('請選擇成績檔');if(list.length>100)throw new Error('一次最多 100 個檔案');\n  return Promise.all(list.map(async f=>{if(f.size>100000)throw new Error(f.name+' 超過 100 KB');return {name:f.name,text:await f.text()};}));}\nfunction renderCsv(items){$('csvRows').replaceChildren();items.forEach(it=>{const tr=document.createElement('tr');\n  [it.file,(it.cls||'')+' / '+(it.seat||''),(it.unit||'')+' / '+(it.paper||''),it.score??'',it.pass===undefined?'':(it.pass?'通過':'未通過'),it.attempt??'',it.label+(it.message?'：'+it.message:'')].forEach((v,i)=>{const td=document.createElement('td');td.textContent=String(v);if(i===6)td.className=statusClass(it.status);tr.append(td);});\n  $('csvRows').append(tr);});}\n$('csvPreview').onclick=async()=>{try{csvPayload=await readCsvFiles();}catch(e){$('status').textContent=e.message;return;}\n  rpc('previewCsv',[csvPayload,$('csvSemester').value.trim()],items=>{renderCsv(items);$('csvImport').disabled=false;\n    const c={};items.forEach(i=>c[i.label]=(c[i.label]||0)+1);$('status').textContent='檢查完成：'+Object.keys(c).map(k=>k+' '+c[k]+' 筆').join('、');});};\n$('csvImport').onclick=()=>{if(!csvPayload){$('status').textContent='請先檢查檔案';return;}\n  rpc('importCsv',[csvPayload,$('csvSemester').value.trim(),$('csvIncludeUnverified').checked],res=>{csvPayload=null;$('csvImport').disabled=true;$('csvRows').replaceChildren();$('csvFiles').value='';\n    rpc('listRecords',[],rows=>{render(rows);$('status').textContent='已匯入 '+res.imported+' 筆。';});});};\nfunction showSlips(list,title){$('slips').replaceChildren();list.forEach(c=>{const d=document.createElement('div');d.className='slip';\n  d.innerHTML='汽車電系考評　成績檔代碼<br>班級：<span></span>　座號：<span></span><br><b></b><br><small>交成績檔時輸入，請勿借給他人</small>';\n  const spans=d.querySelectorAll('span');spans[0].textContent=c.cls;spans[1].textContent=c.seat;d.querySelector('b').textContent=c.code;$('slips').append(d);});\n  $('printSlips').disabled=!list.length;$('rosterInfo').textContent=title;}\n$('rosterCreate').onclick=()=>rpc('createRoster',[$('rosterCls').value.trim(),Number($('rosterFrom').value),Number($('rosterTo').value)],res=>{\n  showSlips(res.created,'新產生 '+res.created.length+' 位代碼'+(res.skipped.length?'；已有代碼而略過的座號：'+res.skipped.join('、')+'（需要新代碼請用「重設」）':'')+'。離開本頁後代碼不會再顯示。');});\n$('rosterReset').onclick=()=>{const seat=$('resetSeat').value.trim();if(!seat){$('status').textContent='請輸入要重設的座號';return;}\n  if(!confirm('重設後舊代碼立即失效，確定重設 '+$('rosterCls').value.trim()+' '+seat+' 號？'))return;\n  rpc('resetCode',[$('rosterCls').value.trim(),seat],c=>showSlips([c],'已重設 '+c.cls+' '+c.seat+' 號的代碼，舊代碼已失效。'));};\n$('rosterRemove').onclick=()=>{const cls=$('rosterCls').value.trim(),seat=$('resetSeat').value.trim();if(!cls||!seat){$('status').textContent='請輸入班級代號與座號';return;}\n  if(!confirm('確定從名單移除 '+cls+' '+seat+' 號？代碼會立即失效，已匯入的成績會保留。'))return;\n  rpc('removeRosterSeat',[cls,seat],r=>{$('slips').replaceChildren();$('printSlips').disabled=true;$('rosterInfo').textContent='已移除 '+r.cls+' '+r.seat+' 號，成績紀錄保留。';});};\n$('rosterList').onclick=()=>rpc('listRoster',[$('rosterCls').value.trim()],list=>{$('slips').replaceChildren();$('printSlips').disabled=true;\n  $('rosterInfo').textContent=list.length?'名單共 '+list.length+' 位：'+list.map(x=>x.seat+(x.resetAt?'（已重設）':'')).join('、')+'。代碼不會再顯示，忘記請重設。':'這個班級尚未建立名單。';});\n$('printSlips').onclick=()=>{document.body.classList.add('print-slips');window.print();setTimeout(()=>document.body.classList.remove('print-slips'),500);};\nconst SECTION=window.NTC_SECTION||'all';\nif(SECTION!=='all'){document.querySelectorAll('.full').forEach(e=>e.hidden=true);document.querySelectorAll('section[data-sec]').forEach(e=>{if(e.dataset.sec!==SECTION)e.hidden=true;});}\nif(SECTION==='all'||SECTION==='review')reload();else{$('status').textContent='';}\n<\/script></body></html>\n","Links":"<!DOCTYPE html><html lang=\"zh-TW\"><head><base target=\"_blank\"><meta charset=\"UTF-8\">\n<style>body{font:15px system-ui,sans-serif;color:#243746;margin:8px}input,button{font:inherit;padding:6px 10px;margin:3px}button{cursor:pointer}\n.row{margin:6px 0}.hint{color:#5d6d7e;font-size:13px}.bad{color:#c0392b}.ok{color:#1e8449}\n#cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:12px;margin-top:12px}\n.card{border:1px solid #ccd5df;border-radius:8px;padding:10px;t
cument.getElementById(id);\r\n$('reportId').value=new URL(location.href).searchParams.get('id')||'';\r\nfunction date(value){const d=new Date(value);return Number.isNaN(d.getTime())?'—':d.toLocaleString('zh-TW');}\r\n$('lookup').onsubmit=event=>{event.preventDefault();$('report').hidden=true;$('status').textContent='查驗中…';google.script.run.withFailureHandler(()=>{$('status').textContent='暫時無法查驗，請稍後再試。';}).withSuccessHandler(result=>{if(!result||!result.valid){$('status').textContent='報告不存在、已到期或簽章不符。';return;}const r=result.report;$('facts').replaceChildren();[['報告 ID',r.reportId],['班級／座號',r.cls+'／'+r.seat],['學期',r.semester],['核發時間',date(r.issuedAt)],['有效期限',date(r.expiresAt)]].forEach(([key,value])=>{const dt=document.createElement('dt'),dd=document.createElement('dd');dt.textContent=key;dd.textContent=value;$('facts').append(dt,dd);});$('records').replaceChildren();r.records.forEach(item=>{const tr=document.createElement('tr');[({horn:'喇叭',start:'起動'}[item.unit]||item.unit)+'／'+(item.task||'—'),item.initialScore,item.finalScore,Object.entries(item.parts||{}).map(([key,value])=>key+'：'+value).join('；')||'未提供分項',date(item.approvedAt)].forEach(value=>{const td=document.createElement('td');td.textContent=value;tr.append(td);});$('records').append(tr);});$('report').hidden=false;$('status').textContent='查驗通過。';}).verifyInterviewReport($('reportId').value.trim());};\r\n$('printBtn').onclick=()=>window.print();\r\nif($('reportId').value)$('lookup').requestSubmit();\r\n<\/script></body></html>"};
